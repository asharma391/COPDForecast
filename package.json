{
  "name": "copd-forecast",
  "version": "1.0.0",
  "private": true,
  "description": "Weather-based COPD respiratory impact calculator and activity planner.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asharma391/COPDForecast.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" *.ts *.mjs *.json scripts/*.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" *.ts *.mjs *.json scripts/*.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "chart.js": "4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "eslint": "10.10.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
